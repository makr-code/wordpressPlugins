{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "title": "Clean Slate",
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#0f1f31"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|4"
    },
    "typography": {
      "lineHeight": "1.65",
      "letterSpacing": "0"
    },
    "elements": {
      "link": {
        "color": {
          "text": "#1e6fba"
        },
        ":hover": {
          "color": {
            "text": "#154f8a"
          }
        }
      },
      "button": {
        "color": {
          "background": "#1e6fba",
          "text": "#ffffff"
        },
        "border": {
          "radius": "6px"
        },
        "spacing": {
          "padding": {
            "top": "0.625rem",
            "right": "1rem",
            "bottom": "0.625rem",
            "left": "1rem"
          }
        }
      }
    }
  }
}
