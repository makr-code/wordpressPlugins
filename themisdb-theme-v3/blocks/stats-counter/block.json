{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "themisdb/stats-counter",
    "title": "ThemisDB Stats Counter",
    "category": "theme",
    "icon": "chart-bar",
    "description": "Single stats item with optional animated counter.",
    "textdomain": "themisdb-v3",
    "attributes": {
        "label": {
            "type": "string",
            "default": ""
        },
        "target": {
            "type": "number",
            "default": 0
        },
        "prefix": {
            "type": "string",
            "default": ""
        },
        "suffix": {
            "type": "string",
            "default": ""
        },
        "animate": {
            "type": "boolean",
            "default": true
        },
        "valueText": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "html": false,
        "multiple": true,
        "inserter": false,
        "auto_register": true
    },
    "render": "file:./render.php"
}
